{#- Render GitHub Dependabot config from ``dependabot.updates[]`` in the
   profile, under the fleet policy (docs/FLEET-BASELINE.md): weekly
   cadence, patch/minor version updates grouped, every security update
   grouped so one pull request can clear every open advisory, and
   semver-major updates never ignored - under a zero-tolerance dependency
   gate a fix that only ships in a new major has to be able to arrive. -#}
{%- set dep = dependabot | default({}, true) -%}
version: 2
updates:
{% for update in dep.get('updates') or [] %}
  - package-ecosystem: {{ update['ecosystem'] }}
    directory: "{{ update['directory'] }}"
    schedule:
      interval: {{ update.get('interval') or 'weekly' }}
    open-pull-requests-limit: {{ update.get('limit') or 10 }}
{% if update.get('versioning_strategy') %}
    versioning-strategy: {{ update['versioning_strategy'] }}
{% endif %}
    groups:
{% for group_name, group in (update.get('groups') or {'minor-patch': {}}).items() %}
      {{ group_name }}:
        applies-to: version-updates
        patterns:
{% for pattern in group.get('patterns') or ['*'] %}
          - "{{ pattern }}"
{% endfor %}
        update-types:
{% for t in group.get('update_types') or ['patch', 'minor'] %}
          - {{ t }}
{% endfor %}
{% endfor %}
      security-updates:
        applies-to: security-updates
        patterns:
          - "*"
    labels:
{% for label in update.get('labels') or ['dependencies'] %}
      - {{ label }}
{% endfor %}
{% endfor %}
