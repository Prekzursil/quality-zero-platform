#!/usr/bin/env bash
set -euo pipefail
# Isolation: when run from a git hook, git exports GIT_DIR/GIT_WORK_TREE/etc into
# the env, which makes fixture-test git commands operate on the REAL repo. Clear them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX GIT_REFLOG_ACTION GIT_QUARANTINE_PATH 2>/dev/null || true

if command -v python >/dev/null 2>&1; then
  PYTHON_CMD=(python)
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_CMD=(python3)
elif command -v py >/dev/null 2>&1; then
  PYTHON_CMD=(py -3)
else
  echo "No Python interpreter found on PATH." >&2
  exit 1
fi

# Working-tree churn guard. Lane writers resolve their default --out-json/--out-md
# against the cwd, so a test that drives one without isolating the cwd writes real
# reports into the repo. That is how eight generated files reached git in ec6e80a.
# We compare the porcelain status BEFORE and AFTER, so pre-existing local edits are
# untouched and only files this run created/changed can fail the gate.
TREE_GUARD=0
TREE_BEFORE=""
if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  TREE_GUARD=1
  TREE_BEFORE="$(git status --porcelain --untracked-files=all)"
fi

"${PYTHON_CMD[@]}" -m coverage run -m unittest discover -s tests -p 'test_*.py'
"${PYTHON_CMD[@]}" -m coverage xml -o coverage.xml
"${PYTHON_CMD[@]}" -m coverage report --fail-under=100 --show-missing
if command -v node >/dev/null 2>&1; then
  node --test scripts/provider_ui/*.test.mjs
fi
"${PYTHON_CMD[@]}" scripts/quality/validate_control_plane.py --write-generated generated/rulesets
"${PYTHON_CMD[@]}" scripts/quality/generate_ruleset_payload.py --output-dir build/rulesets >/dev/null

if [ "${TREE_GUARD}" -eq 1 ]; then
  TREE_AFTER="$(git status --porcelain --untracked-files=all)"
  if [ "${TREE_BEFORE}" != "${TREE_AFTER}" ]; then
    echo "scripts/verify changed the working tree." >&2
    echo "Isolate the writer (tests/workspace_isolation.py isolated_cwd) or ignore the path:" >&2
    diff <(printf '%s\n' "${TREE_BEFORE}") <(printf '%s\n' "${TREE_AFTER}") >&2 || true
    exit 1
  fi
fi
