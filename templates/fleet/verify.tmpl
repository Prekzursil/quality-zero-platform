#!/usr/bin/env bash
# Canonical local verification for ${repo_slug}.
#
# Runs every lane of the QZP lean gate with quality-zero-platform's preflight
# at the EXACT commit that .github/workflows/quality.yml pins, so a local pass
# means what a CI pass means. Managed by quality-zero-platform
# (docs/FLEET-BASELINE.md); arguments are passed through to the preflight.
#
#   bash scripts/verify
#   QZP_DIR=/path/to/a/dedicated/qzp/clone bash scripts/verify
set -euo pipefail

root="$$(git rev-parse --show-toplevel)"
# the pin of whichever workflow calls the lean gate (quality.yml by convention)
pin="$$(grep -rhE '^[^#]*uses:.*reusable-quality\.yml@[0-9a-f]{40}' "$$root/.github/workflows" 2>/dev/null | grep -oE 'reusable-quality\.yml@[0-9a-f]{40}' | head -n 1 | cut -d@ -f2 || true)"
if [ -z "$$pin" ]; then
  echo "verify: no workflow in .github/workflows pins reusable-quality.yml to a 40-hex commit; wire the lean gate first." >&2
  exit 2
fi

# A dedicated clone per pinned commit, never your working copy of QZP: every run forces it
# to the pin and cleans it, so an edit made there can never leak into a verdict.
qzp="$${QZP_DIR:-$${XDG_CACHE_HOME:-$$HOME/.cache}/qzp-verify/$$pin}"
if [ ! -d "$$qzp/.git" ]; then
  mkdir -p "$$(dirname "$$qzp")"
  git clone --quiet --filter=blob:none https://github.com/Prekzursil/quality-zero-platform.git "$$qzp"
fi
git -C "$$qzp" fetch --quiet origin "$$pin"
git -C "$$qzp" -c advice.detachedHead=false checkout --quiet --force --detach "$$pin"
git -C "$$qzp" clean -ffdq

cd "$$root"
exec bash "$$qzp/scripts/quality/preflight.sh" "$$@"
