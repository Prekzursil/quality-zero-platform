@@ -0,0 +1,59 @@
+package src
+
+// Simple is comfortably under any sane CCN threshold.
+func Simple(value int) int {
+	if value > 0 {
+		return value
+	}
+	return -value
+}
+
+// Knot is deliberately over the threshold, in Go, to prove the lane is
+// language-agnostic and not Python-only.
+func Knot(value int, mode string, a bool, b bool, c bool) int {
+	total := 0
+	if value > 1 {
+		total++
+	}
+	if value > 2 {
+		total += 2
+	}
+	if value > 3 {
+		total += 3
+	}
+	if value > 4 {
+		total += 4
+	}
+	if value > 5 {
+		total += 5
+	}
+	switch mode {
+	case "a":
+		total += 6
+	case "b":
+		total += 7
+	case "c":
+		total += 8
+	case "d":
+		total += 9
+	default:
+		total += 10
+	}
+	if a && b {
+		total += 11
+	}
+	if b || c {
+		total += 12
+	}
+	if a && c {
+		total += 13
+	}
+	for i := 0; i < value; i++ {
+		if i%2 == 0 {
+			total += i
+		} else {
+			total -= i
+		}
+	}
+	return total
+}
